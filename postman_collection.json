                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/comparisons/{{comparisonId}}",
              "host": ["{{baseUrl}}"],
              "path": ["comparisons", "{{comparisonId}}"]
            },
            "description": "Menghapus perbandingan dengan menerapkan soft delete."
          },
          "response": []
