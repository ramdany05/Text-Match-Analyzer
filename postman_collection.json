{
  "info": {
    "_postman_id": "c8f23789-9a21-4f8a-9e12-3a890bfa1e01",
    "name": "Text Match Analyzer API",
    "description": "Postman collection untuk menguji seluruh REST API Text Match Analyzer (Authentication, Comparisons CRUD, Calculation Strategy, Statistics, dan User Management).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "comparisonId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Seed Account)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const responseJson = pm.response.json();",
                  "    if (responseJson.data && responseJson.data.token) {",
                  "        pm.collectionVariables.set('token', responseJson.data.token);",
                  "        console.log('JWT Token successfully set to collection variable.');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"tester\",\n  \"password\": \"inipasswordnya\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login menggunakan akun demo bawaan untuk mendapatkan JWT Bearer token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Text Match Comparisons",
      "item": [
        {
          "name": "Calculate & Create - Case Sensitive (ABBCD vs Gallant Duck = 20%)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const res = pm.response.json();",
                  "    if (res.data && res.data.id) {",
                  "        pm.collectionVariables.set('comparisonId', res.data.id);",
                  "    }",
                  "    pm.test('Percentage should be 20.00%', function() {",
                  "        pm.expect(res.data.percentage).to.eql(20);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input1\": \"ABBCD\",\n  \"input2\": \"Gallant Duck\",\n  \"mode\": \"SENSITIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/comparisons",
              "host": ["{{baseUrl}}"],
              "path": ["comparisons"]
            },
            "description": "Menguji pencocokan case sensitive sesuai kriteria contoh soal (menghasilkan 20.00%)."
          },
          "response": []
        },
        {
          "name": "Calculate & Create - Case Insensitive (ABBCD vs Gallant Duck = 60%)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const res = pm.response.json();",
                  "    pm.test('Percentage should be 60.00%', function() {",
                  "        pm.expect(res.data.percentage).to.eql(60);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input1\": \"ABBCD\",\n  \"input2\": \"Gallant Duck\",\n  \"mode\": \"INSENSITIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/comparisons",
              "host": ["{{baseUrl}}"],
              "path": ["comparisons"]
            },
            "description": "Menguji pencocokan case insensitive sesuai kriteria contoh soal (menghasilkan 60.00%)."
          },
          "response": []
        },
        {
