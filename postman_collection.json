            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input1\": \"HELLO\",\n  \"input2\": \"Hello World\",\n  \"mode\": \"INSENSITIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/comparisons/{{comparisonId}}",
              "host": ["{{baseUrl}}"],
              "path": ["comparisons", "{{comparisonId}}"]
            },
            "description": "Mengubah input atau mode perbandingan, sistem akan otomatis menghitung ulang hasilnya."
          },
