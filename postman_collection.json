              "raw": "{{baseUrl}}/comparisons?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["comparisons"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Mendapatkan daftar riwayat perbandingan milik pengguna dengan paginasi."
          },
          "response": []
